# Supabase (EXPO_PUBLIC_ 접두사가 있어야 클라이언트에서 읽힘)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 목 데이터 모드 (true = 백엔드 없이 더미 데이터로 동작)
EXPO_PUBLIC_USE_MOCK=false

# 카카오맵 JavaScript 키 (카카오 developers → 앱 → JavaScript 키)
EXPO_PUBLIC_KAKAO_JS_KEY=

# 카카오 로컬 API REST 키 (카카오 developers → 앱 → REST API 키)
# 헬스장 등록 시 장소 검색(키워드 검색으로 거리순 후보 표시)에 사용. 비어있으면 검색 결과 없이 직접 입력만 가능.
EXPO_PUBLIC_KAKAO_REST_KEY=
